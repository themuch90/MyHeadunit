[Unit]
Description=Head unit - interfaccia Flutter (kiosk, Cage mono-client)
After=headunit-docker.service
Requires=headunit-docker.service

[Service]
User=headunit
# App Flutter Linux desktop standard (target ufficiale "linux", nessun
# embedder custom): Cage la lancia come unico client Wayland fullscreen.
ExecStart=/usr/bin/cage -- /opt/headunit/app/bundle/headunit_app
Restart=always
RestartSec=2
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=graphical.target
